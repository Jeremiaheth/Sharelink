# ShareLink NG Backend - Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# Never commit actual secrets to version control.

# Application
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Use the Session Pooler connection string (IPv4) provided by Supabase.
# IMPORTANT: Replace [YOUR-PASSWORD] with your actual database password.
# Example from Supabase:
# postgresql://postgres.xqabckaqjadvjanqevnh:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xqabckaqjadvjanqevnh:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Authentication / JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Paystack (Payments & Payouts)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (project ref: xqabckaqjadvjanqevnh)
# Get these from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xqabckaqjadvjanqevnh.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Note: The main DATABASE_URL above uses the Session Pooler connection string.

# MikroTik Router Integration (per-host or hub routers)
# These are examples - actual router credentials will be stored per Router entity
MIKROTIK_DEFAULT_HOST=192.168.88.1
MIKROTIK_DEFAULT_USER=admin
MIKROTIK_DEFAULT_PASSWORD=your-router-password
MIKROTIK_DEFAULT_PORT=8728

# Notifications
# WhatsApp Business API or provider (e.g. Twilio, Termii, etc.)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Push Notifications (Firebase or OneSignal, etc.)
FCM_SERVER_KEY=
PUSH_NOTIFICATION_PROVIDER=onesignal

# Security & CORS
CORS_ORIGIN=http://localhost:3001,https://your-frontend-domain.com

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=

# Feature Flags / Pilot Settings
PILOT_ESTATE_ID=lagos-estate-001
DEFAULT_HOST_REVENUE_SHARE=0.55
