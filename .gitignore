# ShareLink NG - Root .gitignore
# This file covers the overall monorepo. Individual packages (backend, mobile, etc.) may have additional rules.

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
!.env.example
!.env.*.example

# Dependencies
node_modules/
**/node_modules/

# Build & distribution
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Misc
*.tgz
*.zip
.cache/
.temp/
.tmp/
